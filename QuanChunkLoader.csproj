<Project Sdk="Microsoft.NET.Sdk">
  <!-- Framework, references, deploy and packaging come from Directory.Build.props/.targets. -->
  <PropertyGroup>
    <AssemblyName>QuanChunkLoader</AssemblyName>
    <RootNamespace>QuanChunkLoader</RootNamespace>

    <!-- The ONLY place to bump the version: feeds the plugin attribute and the generated manifest.json -->
    <Version>1.1.3</Version>

    <!-- Thunderstore manifest description: max 250 characters, no double quotes. -->
    <ThunderstoreDescription>Chunk loader that keeps bases producing while you are away, even after the last logout, hands ownership back to nearby players, keeps moored boats afloat and runs surtling farms. Replaces ChunkLoader and ChunkLoaderFix.</ThunderstoreDescription>
    <!-- Becomes website_url in manifest.json: the Thunderstore page's link to the repo (and its Issues).
         Leave empty to use this repo's git remote automatically; set it only to point somewhere else. -->
    <RepoUrl></RepoUrl>

    <!-- Keep other projects and reference material out of the mod's compile glob. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Diagnostics/**;Upstream Previous Mods/**;research/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Zone coordinates (Vector2s) live in assembly_utils, Localization in assembly_guiutils; the observer
       model's sparks need the particle module, the phantom's clean-up the audio module, and map pins Splatform. -->
  <ItemGroup>
    <Reference Include="assembly_utils"><HintPath>$(ManagedDir)\assembly_utils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_guiutils"><HintPath>$(ManagedDir)\assembly_guiutils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(ManagedDir)\UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Splatform"><HintPath>$(ManagedDir)\Splatform.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Frogger's original chunk loader model (MIT, see THIRD-PARTY-NOTICES.md), loaded with Jotunn's AssetUtils. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\chunkloader" LogicalName="QuanChunkLoader.Assets.chunkloader" />
  </ItemGroup>

  <!-- Extra Thunderstore dependencies beyond BepInExPack and Jotunn (both added automatically), e.g.
  <ItemGroup>
    <ThunderstoreDependency Include="Author-ModName-1.2.3" />
  </ItemGroup>
  -->
</Project>
